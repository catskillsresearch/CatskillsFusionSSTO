<?xml version="1.0"?>

<!-- CATSKILLS-SSTO-TA-GRENADIER default: on runway, gear down, no ET/SRB -->

<PropertyList include="CatskillsFusionSSTO-common.xml">
<sim>
  <description>CATSKILLS-SSTO-TA-GRENADIER (runway)</description>
  <long-description>
    CATSKILLS-SSTO-TA-GRENADIER is a single-stage-to-orbit test article (Grenadier): Shuttle-derived airframe with CHARM plant and 3-cycle electric engine. Default start is on the runway at KSVH — gear down, payload bay closed, no external tank or boosters.
  </long-description>
  <presets>
    <airport-id type="string">KSVH</airport-id>
    <on-ground type="bool">true</on-ground>
    <airspeed-kt type="double">0</airspeed-kt>
    <pitch-deg type="double">0</pitch-deg>
    <altitude-ft type="double">0</altitude-ft>
    <stage type="int">7</stage>
  </presets>
  <startup>
    <!-- Temporary: approach still until runway-gear splash art exists -->
    <splash-texture>Aircraft/CatskillsFusionSSTO/CatskillsFusionSSTO-approach-splash.png</splash-texture>
  </startup>
  <previews>
      <preview>
        <type>exterior</type>
        <splash type="bool">true</splash>
        <path>Pics/approach-splash01.png</path>
      </preview>
      <preview>
        <type>exterior</type>
        <splash type="bool">true</splash>
        <path>Pics/approach-splash02.jpg</path>
      </preview>
      <preview>
        <type>exterior</type>
        <splash type="bool">true</splash>
        <path>Pics/glide-splash01.jpg</path>
      </preview>
  </previews>
  <config>
    <shuttle>
      <prelaunch-flag type="int">0</prelaunch-flag>
    </shuttle>
  </config>
  <menubar>
     <default>
	<menu n="51">
	      <label>Payload Operations</label>

	      <item>
	       <label>Payload bay floodlights</label>
	       <binding>
		<command>nasal</command>
		<script>SpaceShuttle.pb_floodlight_dlg.open()</script>
	       </binding>
	      </item>

	      <item>
	       <label>RMS arm deployment</label>
	       <binding>
		<command>nasal</command>
		<script>SpaceShuttle.rms_deploy_dlg.open()</script>
	       </binding>
	      </item>

	      <item>
	       <label>RMS arm operation</label>
	       <binding>
		<command>nasal</command>
		<script>SpaceShuttle.rms_operation_dlg.open()</script>
	       </binding>
	      </item>

	      <item>
	       <label>Payload retention</label>
	       <binding>
		<command>nasal</command>
		<script>SpaceShuttle.pl_retention_dlg.open()</script>
	       </binding>
	      </item>

	      <item>
	       <label>RMS Pyro</label>
	       <binding>
		<command>nasal</command>
		<script>SpaceShuttle.rms_pyro_dlg.open()</script>
	       </binding>
	      </item>
	     </menu>
     </default>
  </menubar>
</sim>

<controls>
  <shuttle>
    <ET-static-model type="bool">false</ET-static-model>
    <SRB-static-model type="bool">false</SRB-static-model>
  </shuttle>
  <gear>
    <gear-down type="bool">true</gear-down>
  </gear>
</controls>

<fdm>
   <jsbsim>
	<systems>
	   <dps>
		<ops type="int">3</ops>
		<major-mode type="int">305</major-mode>
		<ops-bfs type="int">3</ops-bfs>
		<major-mode-bfs type="int">305</major-mode-bfs>
	   </dps>
	</systems>
   </jsbsim>
</fdm>

</PropertyList>
