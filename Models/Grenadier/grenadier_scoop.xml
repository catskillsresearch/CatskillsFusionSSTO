<?xml version="1.0"?>
<!--
  Twin shoulder scoops: forward mouths + re-entry doors on heritage OMS pods.
  Pod shells + aft RCS "4 dots" stay in OMSPods.ac (only OMS bells hidden).
-->
<PropertyList>
  <path>Aircraft/CatskillsFusionSSTO/Models/Grenadier/grenadier_scoop.ac</path>

  <effect>
    <inherits-from>Aircraft/CatskillsFusionSSTO/Models/Effects/shuttle-main</inherits-from>
    <object-name>grenadier-scoop-L-lip</object-name>
    <object-name>grenadier-scoop-L-cavity</object-name>
    <object-name>grenadier-scoop-L-door-A</object-name>
    <object-name>grenadier-scoop-L-door-B</object-name>
    <object-name>grenadier-scoop-L-hinge</object-name>
    <object-name>grenadier-scoop-L-duct</object-name>
    <object-name>grenadier-scoop-R-lip</object-name>
    <object-name>grenadier-scoop-R-cavity</object-name>
    <object-name>grenadier-scoop-R-door-A</object-name>
    <object-name>grenadier-scoop-R-door-B</object-name>
    <object-name>grenadier-scoop-R-hinge</object-name>
    <object-name>grenadier-scoop-R-duct</object-name>
    <object-name>grenadier-scoop-plenum</object-name>
  </effect>

  <!-- Doors close across the mouth when inlet-sealed (σ3 / re-entry). -->
  <animation>
    <type>translate</type>
    <object-name>grenadier-scoop-L-door-A</object-name>
    <object-name>grenadier-scoop-R-door-A</object-name>
    <property>/fdm/jsbsim/systems/grenadier/engine/inlet-sealed</property>
    <factor>0.42</factor>
    <axis><x>0</x><y>1</y><z>0</z></axis>
  </animation>
  <animation>
    <type>translate</type>
    <object-name>grenadier-scoop-L-door-B</object-name>
    <object-name>grenadier-scoop-R-door-B</object-name>
    <property>/fdm/jsbsim/systems/grenadier/engine/inlet-sealed</property>
    <factor>-0.42</factor>
    <axis><x>0</x><y>1</y><z>0</z></axis>
  </animation>
</PropertyList>
